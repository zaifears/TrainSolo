{
  "name": "seat-selector",
  "version": "1.0.0",
  "description": "Personal Bangladesh Railway Assistant - Local Playwright Seat Selector",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsx src/main.ts",
    "dry-run": "tsx src/main.ts --dry-run",
    "fast": "tsx src/run-fast.ts --live",
    "fast-dry-run": "tsx src/run-fast.ts --dry-run",
    "fast-watch": "tsx src/run-fast.ts --live --watch",
    "fast-watch-dry": "tsx src/run-fast.ts --dry-run --watch",
    "test-brave": "tsx src/test-connection.ts",
    "inspect": "tsx src/inspect-live.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "railway",
    "bangladesh",
    "playwright",
    "cdp",
    "seat-selector"
  ],
  "author": "Md Al Shahoriar Hossain",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
